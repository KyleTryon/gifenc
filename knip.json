{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "bench/browser/bench.js",
    "bench/video-report/report.js",
    "examples/browser/worker.js",
    "examples/node/encode.ts",
    "examples/node/encode-dither.ts",
    "test/**/*.test.mjs"
  ],
  "project": [
