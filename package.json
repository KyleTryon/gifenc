{
  "name": "gifenc",
  "version": "1.0.3",
  "description": "very fast JS GIF encoder",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "main": "./dist/gifenc.cjs",
  "module": "./dist/gifenc.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gifenc.mjs",
      "require": "./dist/gifenc.cjs",
      "default": "./dist/gifenc.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    }
  },
  "author": {
    "name": "Matt DesLauriers",
    "email": "dave.des@gmail.com",
    "url": "https://github.com/mattdesl"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.4",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "knip": "^6.15.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "scripts": {
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run check",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --max-warnings=0",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run typecheck:api && pnpm run typecheck:examples && pnpm run knip",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.test-types.json",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs && pnpm run build:types",
    "build:esm": "esbuild ./src/index.ts --bundle --format=esm --outfile=dist/gifenc.mjs --sourcemap --target=es2018",
    "build:cjs": "esbuild ./src/index.ts --bundle --format=cjs --outfile=dist/gifenc.cjs --sourcemap --target=es2018",
    "build:types": "tsc -p tsconfig.types.json",
    "serve": "node scripts/serve.mjs",
    "dist:cjs": "pnpm run build:cjs",
    "knip": "knip"
  },
  "keywords": [
    "gif",
    "encoder"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/mattdesl/gifenc.git"
  },
  "homepage": "https://github.com/mattdesl/gifenc",
  "bugs": {
    "url": "https://github.com/mattdesl/gifenc/issues"
  }
}
