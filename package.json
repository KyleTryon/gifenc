{
  "name": "@techsquidtv/gifenc",
  "version": "1.1.0",
  "description": "very fast JS GIF encoder",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "main": "./dist/gifenc.cjs",
  "module": "./dist/gifenc.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gifenc.mjs",
      "require": "./dist/gifenc.cjs",
      "default": "./dist/gifenc.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    }
  },
  "author": {
    "name": "Matt DesLauriers",
    "email": "dave.des@gmail.com",
    "url": "https://github.com/mattdesl"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "knip": "^6.45.0",
    "omggif": "^1.0.10",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "scripts": {
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run check",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --max-warnings=0",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run typecheck:api && pnpm run typecheck:examples && pnpm run test:runtime && pnpm run knip",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.test-types.json",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "test:runtime": "pnpm run build:esm && node --test test/**/*.test.mjs",
    "test:package": "node scripts/check-package.mjs",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs && pnpm run build:types",
    "bench:node": "pnpm run build:esm && node bench/node/bench.mjs",
    "bench:compare": "node scripts/compare-benchmarks.mjs",
    "bench:review": "node scripts/review-performance.mjs",
    "build:benchmark-pages": "node scripts/build-benchmark-pages.mjs",
    "build:esm": "esbuild ./src/index.ts --bundle --format=esm --outfile=dist/gifenc.mjs --sourcemap --target=es2018",
    "build:cjs": "esbuild ./src/index.ts --bundle --format=cjs --outfile=dist/gifenc.cjs --sourcemap --target=es2018",
    "build:types": "tsc -p tsconfig.types.json",
    "serve": "node scripts/serve.mjs",
    "dist:cjs": "pnpm run build:cjs",
    "knip": "knip",
    "bench:animation": "pnpm run build:esm && node bench/node/animation.mjs",
    "test:browser": "pnpm run build:esm && node test/browser/smoke.mjs"
  },
  "keywords": [
    "gif",
    "encoder"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyleTryon/gifenc.git"
  },
  "homepage": "https://github.com/KyleTryon/gifenc#readme",
  "bugs": {
    "url": "https://github.com/KyleTryon/gifenc/issues"
  }
}
